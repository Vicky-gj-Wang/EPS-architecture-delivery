                    <mxGeometry x="1035" y="144" width="170" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r2b" value="主SM从 initState 进入 readyState 时，向 IntcurEvnt 写入 evntLoopInitDone&lt;div&gt;（或直接写 Intstate=LoopReadyState）；触发 LoopInit→LoopReady 跳转&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="144" width="370" height="54" as="geometry"/>
                </mxCell>
