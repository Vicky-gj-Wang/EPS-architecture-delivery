                </mxCell>
                <mxCell id="r1b" value="LoopInitState 自保持；&lt;div&gt;StateLoopInit() 每次执行都写 IntcurEvnt=evntLoopInit，维持空闲循环等待主SM切换命令&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="102" width="370" height="40" as="geometry"/>
