                <mxCell id="mod_int_01_table_marker" value="MOD-INT-01" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=center;fontSize=8;fontStyle=1;fontColor=#C62828;rounded=1;" vertex="1" parent="1">
