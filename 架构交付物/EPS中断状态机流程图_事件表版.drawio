                    <mxGeometry x="1035" y="340" width="170" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r6b" value="主SM收到 evntAppOff 后返回 initState，写入 IntcurEvnt=evntLoopOff；&lt;div&gt;跳转表中 LoopRunState+evntLoopOff → StateLoopInit，触发 LoopRun→LoopInit；&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#C62828&quot;&gt;LoopReadyState+evntLoopOff → StateLoopReady（no-op 自保持）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="340" width="370" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r6c" value="主SM写入（跨SM）" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="340" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r7a" value="evntLoopSleep" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="396" width="170" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r7b" value="主SM进入 SleepState 时写入 IntcurEvnt=evntLoopSleep；&lt;div&gt;跳转表中任意状态（Init/Ready/Run/Sleep）+evntLoopSleep → StateLoopSleep；&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#C62828&quot;&gt;LoopFaultState 不响应此事件（→StateLoopFault自保持，故障优先）&lt;/font&gt;；&lt;/div&gt;&lt;div&gt;LoopSleep 内部子状态（Sleep/Wakeup）已实现&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="396" width="370" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r7c" value="主SM写入（跨SM）" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="396" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r8a" value="evntLoopWakeup" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="452" width="170" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="r8b" value="StateLoopSleep() 检测到 switchSleepStatOnOff==FALSE（退出标定命令）时，&lt;div&gt;跨写主SM curEvnt=evntWakeup，同时设置 g_StateInitStartFlag=TASK_TERMINATED；&lt;/div&gt;&lt;div&gt;主SM退出SleepState后，再写回 IntcurEvnt=evntLoopWakeup；&lt;/div&gt;&lt;div&gt;跳转表中 LoopSleepState+evntLoopWakeup → StateLoopInit&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="452" width="370" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="r8c" value="中断SM检测→通知主SM→主SM&lt;div&gt;再写回IntcurEvnt&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="452" width="180" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="r9a" value="evntLoopFault" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="522" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r9b" value="ISR顶层：faultID &amp;amp; FAULT_ID_MASK != 0 时，跨写主SM curEvnt=evntFault&lt;div&gt;（每100μs检测）；主&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;SM进入 faultState 后，再写入 IntcurEvnt=evntLoopFault；&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;任意状态+evntLoopFault → StateLoopFault&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="522" width="370" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r9c" value="ISR顶层检测→主SM接收→主SM写入IntcurEvnt" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="522" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r10a" value="evntLoopFaultClr" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="584" width="170" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="r10b" value="StateLoopFault() 检测到 switchFaultClear==TRUE 时：清除 faultID&lt;div&gt;（保留不可清除位 FAULT_ID_NO_CLEAR），跨写主SM curEvnt=evntFaultClr；&lt;/div&gt;&lt;div&gt;主SM处理后再写入 IntcurEvnt=evntLoopFaultClr；&lt;/div&gt;&lt;div&gt;跳转表中 LoopFaultState+evntLoopFaultClr → StateLoopInit&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="584" width="370" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="r10c" value="中断SM检测→通知主SM→主SM再写回IntcurEvnt" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="584" width="180" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="⚠ 关键设计规则：中断SM（100μs）本身只自保持当前状态；所有状态切换命令（IntcurEvnt的跳变）由主SM（1ms）写入。&lt;div&gt;例外：检测到App开关/休眠/故障清除信号时，中断SM先跨写主SM的curEvnt字段，由主SM下次执行时处理状态切换，然后主SM再反写IntcurEvnt完成中断SM的跳转。&lt;/div&gt;" style="text;html=1;strokeColor=#BDBDBD;fillColor=#FFF8E1;align=left;verticalAlign=middle;fontSize=9;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="664" width="726" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="mod_int_01_flow_marker" value="MOD-INT-01" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=center;fontSize=8;fontStyle=1;fontColor=#C62828;rounded=1;" vertex="1" parent="1">
                    <mxGeometry x="289" y="316" width="76" height="16" as="geometry"/>
