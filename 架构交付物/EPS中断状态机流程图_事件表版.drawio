                    <mxGeometry x="1035" y="200" width="170" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r3b" value="LoopReadyState 自保持；StateLoopReady() 每次执行写 IntcurEvnt=evntLoopReady，&lt;div&gt;同时检测 switch 信号并跨写主SM curEvnt；&lt;font color=&#39;#C62828&#39;&gt;当前版本仅 AppOff 路径有效（AppOn 跨写代码被注释）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
