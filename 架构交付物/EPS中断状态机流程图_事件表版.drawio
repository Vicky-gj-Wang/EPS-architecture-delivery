                    <mxGeometry x="46" y="602" width="480" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="leg3" value="&lt;font color=&#39;#3949AB&#39;&gt;━━→&lt;/font&gt;  休眠路径（任意→LoopSleep；LoopSleep→LoopInit 唤醒）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;align=left;" parent="1" vertex="1">
                    <mxGeometry x="46" y="620" width="480" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="leg4" value="&lt;font color=&#39;#C62828&#39;&gt;━━→&lt;/font&gt;  故障路径（任意→LoopFault；LoopFault→LoopInit 故障清除）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;align=left;" parent="1" vertex="1">
                    <mxGeometry x="46" y="638" width="480" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="leg5" value="- - →  保持（自环）：条件不满足时每100μs重复执行同一状态函数" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;align=left;" parent="1" vertex="1">
                    <mxGeometry x="46" y="656" width="480" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="leg6" value="★注：&lt;b&gt;切换命令（IntcurEvnt=evntLoopXxx）全部由主状态机（1ms任务）写入，&lt;/b&gt;中断SM本身仅自保持当前状态；&lt;div&gt;例外是 evntLoopWakeup / evntLoopFaultClr 需要中断SM先检测→写主SM→主SM再反写IntcurEvnt。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="46" y="674" width="480" height="32" as="geometry"/>
                </mxCell>
