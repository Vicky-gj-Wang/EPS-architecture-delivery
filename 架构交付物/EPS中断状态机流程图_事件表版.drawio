                    <mxGeometry x="1035" y="242" width="170" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r4b" value="主SM进入 runState 时，写入 IntcurEvnt=evntLoopOn；&lt;div&gt;跳转表中 LoopReadyState+evntLoopOn → StateLoopRun，触发 LoopReady→LoopRun&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1208" y="242" width="370" height="54" as="geometry"/>
