                    <mxGeometry x="1035" y="298" width="170" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="r5b" value="LoopRunState 自保持；StateLoopRun() 每次执行写 IntcurEvnt=evntLoopRun，&lt;div&gt;同时执行 FOC 控制算法并检测 switch 信号&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
