                <mxCell id="ow4" value="CPU空闲填充（仅条件满足时插入 ASWParamSectorErase()）" style="rounded=0;fillColor=#616161;strokeColor=#424242;fontSize=7;fontColor=#FFFFFF;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="692" y="530" width="760" height="18" as="geometry"/>
