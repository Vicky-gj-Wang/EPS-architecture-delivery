                <mxCell id="mod_sched_01" value="MOD-SCH-01" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=center;fontSize=8;fontStyle=1;fontColor=#C62828;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="692" y="508" width="80" height="14" as="geometry"/>
                </mxCell>
                <mxCell id="notes" value="&lt;b&gt;优先级规则：&lt;/b&gt;硬件中断（P1~P255，越大越高）&gt;&gt; OS任务（Prio1~16，越大越高）；任何硬件中断均可打断任何OS任务&lt;br&gt; &lt;b&gt;ISR1&lt;/b&gt;（橙色标注）：退出后直接返回被打断处，OS不感知 · 用于FOC/WD/STM等极致实时场景&lt;br&gt; &lt;b&gt;ISR2&lt;/b&gt;（深红标注）：退出时触发OS重新调度，可唤醒任务 · 用于CAN/SPI/ADC等需通知上层的场景 · &lt;b&gt;STM[ISR1*]&lt;/b&gt;：ISR1内部调用CounterTick()间接驱动OS任务定时激活&lt;br&gt; &lt;b&gt;实时性说明：&lt;/b&gt;当前工程未开启中断嵌套，CAN/SPI 到达不会抢占 FOC ISR；图中不将其表述为“CAN打断FOC”的实时性风险，真正需关注的是 ISR 执行时长与任务积压延迟 · 1ms任务最大积压激活数=5（rnact_max）" style="text;html=1;strokeColor=#AAAAAA;fillColor=#FAFAFA;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;rounded=1;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry y="558" width="1460" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="mod_sched_02" value="MOD-SCH-02" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=center;fontSize=8;fontStyle=1;fontColor=#C62828;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="747" y="563" width="80" height="14" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
