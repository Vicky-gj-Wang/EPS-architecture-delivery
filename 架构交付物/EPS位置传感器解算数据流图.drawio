                <mxCell id="col_title_center" value="中央主链路" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#8e24aa;align=center;" vertex="1" parent="1">
                    <mxGeometry x="390" y="70" width="310" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="col_title_left" value="左侧故障支路" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#e91e63;align=center;" vertex="1" parent="1">
                    <mxGeometry x="60" y="160" width="235" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="col_title_right" value="右侧速度支路" style="text;html=0;fontSize=13;fontStyle=1;fontColor=#8e24aa;align=center;" vertex="1" parent="1">
                    <mxGeometry x="800" y="560" width="265" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="n_adc" value="ADC 采样&#xa;MrSampleSin  /  MrSampleCos" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=11;html=0;fillColor=#f8bbd0;strokeColor=#e91e63;fontColor=#880e4f;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="104" width="310" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_debias" value="去直流偏置&#xa;MrSampleSin - MrOffsetSin  →  |MrATANSin| + flag_Sin&#xa;MrSampleCos - MrOffsetCos  →  |MrATANCos| + flag_Cos" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="390" y="215" width="310" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="n_tan" value="大小比较 → Tan 计算&#xa;max(Sin, Cos) 为主导轴&#xa;min / max  →  MrATANTan (Q10)  +  flag_ABS" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="390" y="348" width="310" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n_judge" value="四象限索引合成&#xa;ATAN_Judge = flag_ABS | (flag_Sin &lt;&lt; 1) | (flag_Cos &lt;&lt; 2)&#xa;3bit 组合 → switch 8 分支确定象限" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="390" y="475" width="310" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n_atan" value="ATAN 查表 + 象限补偿&#xa;MR_ARCTG(MrATANTan) + 象限偏移量&#xa;→  MrRotorPosition  (机械角  0 ~ 2π)" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#ce93d8;strokeColor=#8e24aa;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="600" width="310" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="n_pole" value="极对数换算&#xa;MrRotorPosition × PolarNum × 1024 / (π/2)  →  % 4096&#xa;PolarNum = ELE_ROTOR_POLE_PAIR / MRROTOR_POLE_PAIR" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="390" y="740" width="310" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n_ini" value="初始位置补偿&#xa;% 4096  -  MrIniPosition  →  MrElePosition&#xa;越界修正: &lt; 0 则 +4096;  &gt; 4096 则 -4096" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="390" y="870" width="310" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n_foc" value="MrElePosition  (0 ~ 4096)&#xa;→  FOC  Clark / Park 变换  (电流环输入)" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=11;html=0;fillColor=#bbdefb;strokeColor=#1976d2;fontColor=#0d47a1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1000" width="310" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="n_amp" value="幅值计算&#xa;MRATANQuadraticSum&#xa;= MrATANSin² + MrATANCos²" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#fce4ec;strokeColor=#e91e63;fontColor=#880e4f;" parent="1" vertex="1">
                    <mxGeometry x="60" y="220" width="235" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="n_fault" value="MotorSensorCheck()&#xa;幅值窗口检测&#xa;[QuadraticSumMin, QuadraticSumMax]&#xa;超限: MRErrCount++&#xa;连续 &gt;= 10 次  →  判传感器故障&#xa;恢复正常  →  立即清零 + 清除故障" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#fce4ec;strokeColor=#e91e63;fontColor=#880e4f;" parent="1" vertex="1">
                    <mxGeometry x="60" y="373" width="235" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n_faultout" value="FaultIdMSensorErr&#xa;→  安全保护链路" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=11;html=0;fillColor=#f8bbd0;strokeColor=#e91e63;fontColor=#880e4f;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="585" width="235" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n_eeprom" value="MrIniPosition&#xa;来源: EEPROM (上电加载)&#xa;写入方: communicate.c L407&#xa;或 LearnInitPosition.c (标定例程)" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#fff9c4;strokeColor=#f9a825;fontColor=#4e342e;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="871" width="235" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n_cbuf" value="环形缓冲 Delta-theta&#xa;s_position_cal[10] 存储历史角度&#xa;Delta-theta = 当前角 - 10步前角 (差分)" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="800" y="603" width="265" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n_zero" value="过零点换向修正&#xa;Delta-theta &lt; -1.9 rad  →  Delta-theta + 2*pi&#xa;Delta-theta &gt;  1.9 rad  →  Delta-theta - 2*pi&#xa;消除换向时角度跨零点跳变" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="800" y="734" width="265" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_lp" value="一阶低通滤波&#xa;alpha = MR_SPEED_LOWPASS_FILTER_VAL / 1024 = 32/1024&#xa;s_speed = (992 * s_speed + 32 * Delta-theta) / 1024" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=10;html=0;fillColor=#e1bee7;strokeColor=#8e24aa;fontColor=#4a148c;" parent="1" vertex="1">
                    <mxGeometry x="800" y="871" width="265" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n_speed" value="MrMechSpeed  (rpm)&#xa;= 滤波后 Delta-theta × 4774.65&#xa;→  速度外环 PID" style="rounded=1;whiteSpace=wrap;shadow=1;fontSize=11;html=0;fillColor=#ce93d8;strokeColor=#8e24aa;fontColor=#4a148c;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="800" y="1000" width="265" height="68" as="geometry"/>
                </mxCell>
