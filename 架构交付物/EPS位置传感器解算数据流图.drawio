                </mxCell>
                <mxCell id="subtitle" value="入口: GetRotatrPosition()  |  核心: MrATANPositionSpeedAlgorithm()  |  故障: MotorSensorCheck()  |  source: sensor_driver_module/position.c" style="text;html=0;fontSize=10;fontColor=#666666;align=center;" parent="1" vertex="1">
