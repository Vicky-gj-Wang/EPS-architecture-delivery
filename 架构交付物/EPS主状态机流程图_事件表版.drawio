                <mxCell id="r7b" value="switchAppOnOff变为FALSE（来自CAN控制命令）；&lt;div&gt;由IntStateMachine.c中的StateLoopReady/StateLoopRun检测后写curEvnt&lt;/div&gt;&lt;div&gt;&lt;font color=&#39;#C62828&#39;&gt;readyState下收到evntAppOff保持readyState（no-op，自环）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1218" y="364" width="360" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r7c" value="中断状态机改写（跨状态机）" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="364" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r8a" value="evntSleep" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="418" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r8b" value="switchSleepStatOnOff==TRUE（通常由HYCET标定CAN命令置位）；&lt;div&gt;Init/Ready/Run/Fault可进入Sleep；&lt;/div&gt;&lt;div&gt;&lt;font color=&#39;#C62828&#39;&gt;SelfCheck/SelfCheckFault/Calib触发时转入selfCheckFaultState&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1218" y="418" width="360" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r8c" value="主状态机或中断状态机检测后写入" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="418" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r9a" value="evntWakeup" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="472" width="180" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="r9b" value="switchSleepStatOnOff==FALSE（退出标定/唤醒命令）" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1218" y="472" width="360" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="r9c" value="中断状态机StateLoopSleep检测后写入" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="472" width="180" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="r10a" value="evntFault" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="518" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="r10b" value="1) faultID &amp; FAULT_ID_MASK != 0（FOC ISR里100us检测）；&lt;br&gt;2) 主状态机等待IntState同步超时（TimeOut==0）；&lt;br&gt;3) Run中检测到IntState==LoopFaultState" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1218" y="518" width="360" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="r10c" value="中断状态机优先触发；主状态机也会补充触发" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="518" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="r11a" value="&lt;font color=&#39;#C62828&#39;&gt;evntFaultClr&lt;/font&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="580" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r11b" value="&lt;font color=&#39;#C62828&#39;&gt;switchFaultClear==TRUE（CAN诊断/调试命令）；&lt;/font&gt;&lt;div&gt;&lt;font color=&#39;#C62828&#39;&gt;IntStateMachine.c StateLoopFault中清故障后写curEvnt=evntFaultClr&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&#39;#C62828&#39;&gt;状态表行为：faultState→initState；Sleep/init/ready/run→faultState；&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&#39;#C62828&#39;&gt;selfCheck/selfCheckFault/Calib→selfCheckFaultState&lt;/font&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1218" y="580" width="360" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r11c" value="中断状态机改写（跨状态机）" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FFFFFF;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="580" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r12a" value="evntSelfCheckFault" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1035" y="634" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r12b" value="代码中主要靠直接软件复位处理自检失败；该事件保留用于外部注入/扩展容错流程" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;fontSize=9;spacingLeft=4;" parent="1" vertex="1">
                    <mxGeometry x="1218" y="634" width="360" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="r12c" value="外部写curEvnt或后续扩展" style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=center;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1581" y="634" width="180" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="备注：switchAppOnOff / switchSleepStatOnOff / switchFaultClear 的原始来源是CAN命令解析（主要在 communicate.c 和 eps_communicate.c）。" style="text;html=1;strokeColor=#BDBDBD;fillColor=#FFF8E1;align=left;verticalAlign=middle;fontSize=9;spacingLeft=6;" parent="1" vertex="1">
