                <mxCell id="adc_hw" value="&lt;b&gt;VADC 硬件&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;FOC PWM ISR 触发 ADC 采样&lt;br&gt;通道：CH_CURRENT_A / B / C&lt;br&gt;精度：12-bit（ADC_PRECISION_FACTOR=4096）&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="155" y="190" width="350" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="arr_adc_hw_get" value="Adc_ResultGet( CH_CURRENT_A/B/C )" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="adc_hw" target="adc_raw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="adc_raw" value="&lt;b&gt;adc.measured.fltPhA/B/C.raw&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;raw = (ADC_count − OOS_count) / 4095 × 3.3V&lt;br&gt;（OOS：运放偏置参考电压）&lt;br&gt;函数：GetCurrentAdcVal()  &lt;i&gt;(AdcApp.c)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="155" y="285" width="350" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="arr_raw_calib" value="slope × raw − offset × CalibOffset" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="adc_raw" target="fbck_cur" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="fbck_cur" value="&lt;b&gt;FbckCurVal[0/1/2]&lt;/b&gt;（校准后 A 相/B 相/C 相电流，&lt;font color=&#39;#C62828&#39;&gt;单位 A&lt;/font&gt;）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;= fltPhA.raw × slope.fltPhA − offset.fltPhA × CalibOffset[0].fltPhA&lt;br&gt;（IntStateMachine.c 顶层，FOC ISR 入口）&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="130" y="410" width="400" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="arr_fbck_recon" value="扇区选相重构：根据 pwmDutys[] 大小关系，&lt;br&gt;选取两相直采，第三相 = −(Ia + Ib)" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="fbck_cur" target="iAbcFbck" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="iAbcFbck" value="&lt;b&gt;iAbcFbck.fltArg1/2/3&lt;/b&gt;（三相重构电流 Ia, Ib, Ic）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;（IntStateMachine.c，FOC ISR）&lt;br&gt;三相之和恒为零：Ia + Ib + Ic = 0&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="140" y="510" width="380" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="arr_abc_clarke" value="FocCrntLoop() 调用" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="iAbcFbck" target="iAlBeFbck" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="iAlBeFbck" value="&lt;b&gt;iAlBeFbck.fltArg1/2&lt;/b&gt;（Iα, Iβ — 静止坐标系）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Iα = Ia&lt;br&gt;Iβ = (1/√3) × (Ia + 2×Ib)&lt;br&gt;（foc.c：FocCrntLoop 内）&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="140" y="610" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="theta_src" value="&lt;b&gt;thTransform.fltArg1/2&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;sin(θ) / cos(θ)，θ = MrElePosition&lt;br&gt;&lt;font color=&#39;#C62828&#39;&gt;代码现状：θ_delay = θ（未做额外延迟补偿）&lt;/font&gt;&lt;br&gt;由 GetRotatrPosition() 在 ISR 顶层更新&lt;br&gt;（MR 传感器解算，位置线提供）&lt;/font&gt;" style="rounded=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=10;verticalAlign=middle;html=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="630" y="700" width="370" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="mod_cur_01" value="MOD-CUR-01" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=center;fontSize=8;fontStyle=1;fontColor=#C62828;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="535" y="410" width="80" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="mod_cur_02" value="MOD-CUR-02" style="text;html=1;strokeColor=#C62828;fillColor=#FFEBEE;align=center;fontSize=8;fontStyle=1;fontColor=#C62828;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="1005" y="700" width="80" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="arr_theta_park" value="注入转子角度" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#C62828;fontColor=#C62828;dashed=1;" parent="1" source="theta_src" target="idq_fbck" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arr_clarke_park" value="FocCrntLoop()" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="iAlBeFbck" target="idq_fbck" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="idq_fbck" value="&lt;b&gt;idPIDCal.Feedback&lt;/b&gt; = Iα·cosθ + Iβ·sinθ&lt;br&gt;&lt;b&gt;iqPIDCal.Feedback&lt;/b&gt; = Iβ·cosθ − Iα·sinθ&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;（foc.c：FocCrntLoop 内）&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="140" y="735" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="iq_ref_src" value="&lt;b&gt;iqPIDCal.Reference&lt;/b&gt;（力矩电流参考）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;来源：speedPIDCal.Output（速度模式）&lt;br&gt;或 torqCtrl.TorqueMode_IqReq（力矩模式）&lt;br&gt;经 GetIdqFromTorque() 从力矩指令换算&lt;/font&gt;" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="630" y="870" width="370" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="id_ref_src" value="&lt;b&gt;idPIDCal.Reference&lt;/b&gt;（磁通电流参考）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;正常：= 0（非弱磁）&lt;br&gt;弱磁时：= FwPIDcal.Output（AutoFluxWeaken）&lt;/font&gt;" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="630" y="975" width="370" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="arr_iqref_pid" value="注入参考值（1ms更新）" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2E7D32;fontColor=#2E7D32;dashed=1;" parent="1" source="iq_ref_src" target="pid_out" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arr_idref_pid" value="注入参考值（100μs更新）" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#2E7D32;fontColor=#2E7D32;dashed=1;" parent="1" source="id_ref_src" target="pid_out" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arr_fbck_pid" value="AutoFluxWeaken() → ControllerPIDrAW()" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="idq_fbck" target="pid_out" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pid_out" value="&lt;b&gt;uDQReq.fltArg1/2&lt;/b&gt;（Ud, Uq — 旋转坐标系电压指令）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;d轴：idPIDCal.Output（弱磁控制）&lt;br&gt;q轴：iqPIDCal.Output（力矩控制）&lt;br&gt;输出限幅：√(Ud²+Uq²) ≤ Us（直流母线电压/√3）&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="900" width="390" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="arr_dq_invpark" value="反Park（θ同步）：Uα=Ud·cosθ−Uq·sinθ" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="pid_out" target="uAlBeReq" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="invpark_box" value="反Park 变换" style="rounded=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;verticalAlign=middle;html=1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="-13" y="1020" width="110" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="uAlBeReq" value="&lt;b&gt;uAlBeReq.fltArg1/2&lt;/b&gt;（Uα, Uβ — 静止坐标系电压）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;Uα = Ud·cosθ − Uq·sinθ&lt;br&gt;Uβ = Ud·sinθ + Uq·cosθ&lt;br&gt;（foc.c：FocCrntLoop 内）&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="140" y="1020" width="380" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="arr_invpark_svpwm" value="StdSvpwmCalc()（7段SVPWM）" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="uAlBeReq" target="pwmDutys" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="svpwm_box" value="7段 SVPWM" style="rounded=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;verticalAlign=middle;html=1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="-8" y="1130" width="100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="pwmDutys" value="&lt;b&gt;pwmDutys[0/1/2]&lt;/b&gt;（U/V/W 三相 PWM 占空比计数值）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;范围：0 ~ iPWMFullCnt（= 10000 计数 @ 100μs）&lt;br&gt;扇区编号：svmSector（0~5）&lt;br&gt;（foc.c：StdSvpwmCalc 输出，IntStateMachine.c 读取）&lt;/font&gt;" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="1130" width="390" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="arr_duty_pwm" value="Pwm_UVWTonSet( pwmDutys[0], pwmDutys[1], pwmDutys[2] )" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1565C0;fontColor=#1565C0;" parent="1" source="pwmDutys" target="gtm_reg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="gtm_reg" value="&lt;b&gt;GTM 寄存器&lt;/b&gt;（硬件 PWM 输出）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;下一个 PWM 周期生效（延迟 100μs）&lt;br&gt;驱动三相逆变桥，产生电机相电压&lt;/font&gt;" style="rounded=1;fillColor=#B71C1C;strokeColor=#7F0000;fontColor=#ffffff;fontSize=11;verticalAlign=middle;html=1;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="155" y="1240" width="350" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="spd_pos_input" value="&lt;b&gt;positionCtrl.SpeedInCtrl&lt;/b&gt;（实际速度）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;由 GetRotatrPosition() 计算&lt;br&gt;位置差分 → 机械转速（rpm）&lt;/font&gt;" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="635" y="190" width="370" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="spd_ref_input" value="&lt;b&gt;positionCtrl.SpeedInCtrl_Req&lt;/b&gt;（目标速度）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;来自位置环输出（位置模式）&lt;br&gt;或 ASW 直接写入（速度模式）&lt;/font&gt;" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
                    <mxGeometry x="635" y="280" width="370" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="arr_spd_pid" value="SpeedLoop()  每10次ISR（1ms）" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2E7D32;fontColor=#2E7D32;" parent="1" source="spd_ref_input" target="spd_pid_out" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="spd_pid_out" value="&lt;b&gt;speedPIDCal.Output&lt;/b&gt;（力矩指令 / Iq参考）&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;ControllerPIDrAW(&amp;speedPIDCal)&lt;br&gt;（control.c：Err=SpeedReq−SpeedFbc，积分+比例）&lt;br&gt;输出限幅：torqCtrl.Speed_limit.max/min&lt;/font&gt;" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=middle;html=1;" parent="1" vertex="1">
